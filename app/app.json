{
  "expo": {
    "name": "Johnsons",
    "slug": "tech-app",
    "scheme": "garagedoortech",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xjjohnson.garagedoortech"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xjjohnson.garagedoortech"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2b70a853-c332-49ea-8fde-4678952d9d87",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "release": "0.5.73",
      "eas": {
        "projectId": "2b70a853-c332-49ea-8fde-4678952d9d87"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos of a job from your gallery.",
          "cameraPermission": "Take before and after photos of a job.",
          "microphonePermission": "Record voice notes on a job."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take job photos and scan part barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes on a job.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      "./plugins/withReleaseSigning"
    ]
  }
}
